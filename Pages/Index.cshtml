@page
@model IndexModel
@{
    ViewData["Title"] = "Seller";
}

<div class="container py-5">
    <p class="text-uppercase text-primary fw-semibold">Lotly Marketplace</p>
    <h1 class="display-5">Seller</h1>
    <p class="lead">Profil seller pada marketplace Lotly.</p>
    <dl class="row mt-4">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Seller.Id</dd>
        <dt class="col-sm-2">Nama</dt>
        <dd class="col-sm-10">@Model.Seller.StoreName</dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Seller.Email</dd>
    </dl>
</div>
